
[ Test1 ]
<div class="row mb-4">
	<div class="col-2"></div>
	<div class="col-8">
		<h4>Variant Construct Test</h4>
	</div>
	<div class="col-2"></div>
</div>
<div class="row mb-4">
	<div class="col-2"></div>
	<div class="col-8">
		{{ Vector3() }}, {{ Vector3(1, 2, 3) }}, {{ Vector3i() }},  {{ Vector3i(2, 3, 4) }},  {{ [ 1, 2, 3 ] }}, {{ Vector3(1, 2, 3).x }}, {{ Vector3(1, 2, 3)["x"] }},
		{{ Rect2().position.x }}, {{ Transform2D().rotated(1.2) }}, {{ Transform2D().rotated(PI / 1.3) }}<br>
		Linkbutton text: {{ lb.text }}, is hovered: {{ lb.is_hovered() }}, rect: {{ lb.get_rect() }} (if you resize the app's window, this will change (after a refresh))
	</div>
	<div class="col-2"></div>
</div>

[ Test2 ]
<div class="row mb-4">
	<div class="col-2"></div>
	<div class="col-8">
		<h4>Comment Test</h4>
	</div>
	<div class="col-2"></div>
</div>
<div class="row mb-4">
	<div class="col-2"></div>
	<div class="col-8">
		Comment: {{ /*
		{{ Vector3() }}, {{ Vector3(1, 2, 3) }}, {{ Vector3i() }},  {{ Vector3i(2, 3, 4) }},  {{ [ 1, 2, 3 ] }}, {{ Vector3(1, 2, 3).x }}, {{ Vector3(1, 2, 3)["x"] }},
		{{ Rect2().position.x }}, {{ Transform2D().rotated(1.2) }}, {{ Transform2D().rotated(PI / 1.3) }}<br>
		Linkbutton text: {{ lb.text }}, is hovered: {{ lb.is_hovered() }}, rect: {{ lb.get_rect() }} (if you resize the app's window, this will change (after a refresh))
		{{ */ }}
		Comment2: {{ /* test comment */ }}
	</div>
	<div class="col-2"></div>
</div>
